{
  "NEOW.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-0.char": "Where am I?",
  "NEOW.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-0.next": "Continue",
  "NEOW.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-1.ancient": "...A cute... bloodfiend...?",
  "NEOW.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-1.next": "Continue",
  "NEOW.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-2.char": "Who are you?",
  "NEOW.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-2.next": "Continue",
  "NEOW.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-3.ancient": "...You... don't seem... to belong... to this... world...?",
  "NEOW.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-0r.ancient": "...Those... little flying ones... seem... a little... unstable...",
  "NEOW.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.ancient": "...Still haven't... fixed... the problem...?",
  "NEOW.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.next": "Continue",
  "NEOW.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-1.char": "I still need more test data.",
  "NEOW.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-1.next": "Continue",
  "NEOW.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-2.ancient": "...See if... these... can help... you...",
  "OROBAS.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-0.ancient": "What are those little things flying around? Why do they have tiny wings and tails?",
  "OROBAS.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-0.next": "Continue",
  "OROBAS.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-1.char": "They're drones that help me in battle.",
  "OROBAS.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-1.next": "Continue",
  "OROBAS.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-2.ancient": "Amazing!",
  "OROBAS.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-0.ancient": "You're not from this world? Then where are you from?",
  "OROBAS.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-0.next": "Continue",
  "OROBAS.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-1.char": "Terra.",
  "OROBAS.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-1.next": "Continue",
  "OROBAS.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-2.ancient": "Where is Terra? How did you get here?",
  "OROBAS.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.ancient": "Look at this great thing I found recently! Could it help you?",
  "PAEL.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-0.ancient": "You're so full of energy. I hope my flesh can help you...",
  "PAEL.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-0.ancient": "I think you need to get more sleep, like me.",
  "PAEL.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-0.next": "Continue",
  "PAEL.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-1.char": "Not yet. I still have so many things to test.",
  "PAEL.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-1.next": "Continue",
  "PAEL.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-2.ancient": "Then I'll get some rest.",
  "PAEL.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.ancient": "Are you an engineer?",
  "PAEL.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.next": "Continue",
  "PAEL.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-1.char": "Yes. I'm testing my equipment.",
  "PAEL.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-1.next": "Continue",
  "PAEL.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-2.ancient": "Perhaps you and Father would have a lot to talk about.",
  "TEZCATARA.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-0.ancient": "Oh, a new face! Come in and see what you need.",
  "TEZCATARA.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-0.next": "Continue",
  "TEZCATARA.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-1.char": "Could I have a cup of coffee?",
  "TEZCATARA.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-1.next": "Continue",
  "TEZCATARA.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-2.ancient": "Sorry, but you could try some hot cocoa.",
  "TEZCATARA.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-0.ancient": "I couldn't get the coffee you asked for. Need anything else?",
  "TEZCATARA.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.ancient": "You look exhausted. Why not rest here a little longer?",
  "TEZCATARA.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.next": "Continue",
  "TEZCATARA.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-1.char": "Not now. I still have things to do.",
  "TEZCATARA.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-1.next": "Continue",
  "TEZCATARA.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-2.ancient": "Being too tired isn't good for you.",
  "DARV.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-0.char": "This room has so many collectibles.",
  "DARV.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-0.next": "Continue",
  "DARV.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-1.ancient": "See anything you'd like, dear customer?",
  "DARV.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-0.ancient": "You're a merchant too? We might have a lot to talk about.",
  "DARV.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.char": "So many good things! I'll take some back to show the Doctor.",
  "DARV.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.next": "Continue",
  "DARV.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-1.ancient": "Help yourself. I'm sorting things out.",
  "NONUPEIPE.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-0.ancient": "Busy engineer, would you like to sit and have some tea with me?",
  "NONUPEIPE.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-0.ancient": "You seem fond of machinery. I hope these blessings help you.",
  "NONUPEIPE.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.ancient": "Those little flying things of yours look quite advanced.",
  "TANX.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-0.ancient": "Engineer, try this powerful weapon!",
  "TANX.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-0.ancient": "Put a weapon on that little flying thing, and it'll hit even harder!",
  "TANX.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.ancient": "Engineer, fight me!!!",
  "TANX.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.next": "Continue",
  "TANX.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-1.char": "(Tanx and the drones become locked in battle.)",
  "TANX.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-1.next": "Continue",
  "TANX.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-2.ancient": "These little guys are impressive. Try giving them a sharp weapon.",
  "THE_ARCHITECT.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-0.char": "Test complete. Everything is functioning normally.",
  "THE_ARCHITECT.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-0.next": "Continue",
  "THE_ARCHITECT.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.0-1.ancient": "An unfamiliar face. Why have you appeared here!",
  "THE_ARCHITECT.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-0.char": "Experimental data recorded.",
  "THE_ARCHITECT.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-0.next": "Continue",
  "THE_ARCHITECT.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.1-1.ancient": "I need quiet...",
  "THE_ARCHITECT.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.char": "Area clear. Material losses are minimal.",
  "THE_ARCHITECT.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-0.next": "Continue",
  "THE_ARCHITECT.talk.CLOSURE_MOD_CHARACTER_CLOSURE_MOD_CHARACTER.2-1.ancient": "You are not welcome here."
}

